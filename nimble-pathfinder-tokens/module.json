{
  "id": "nimble-pathfinder-tokens",
  "title": "Nimble - Pathfinder Tokens",
  "version": "1.1",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Javier Rivera",
      "email": "javierriveracastro@gmail.com",
      "discord": "javierrivera",
      "flags": {}
    }
  ],
  "flags": {
    "canUpload": true,
    "compendiumArtMappings": {
      "nimble": {
        "mapping": "modules/nimble-pathfinder-tokens/module/map-bestiaries.json",
        "credit": "<em>Portrait, token, and subject artwork from Pathfinder Tokens: Bestiaries.</em>"
      }
    },
    "tokenRingSubjectMappings": {
      "modules/pf2e-tokens-bestiaries/tokens/": "modules/pf2e-tokens-bestiaries/subjects/",
      "modules/pf2e-tokens-monster-core/assets/tokens/": "modules/pf2e-tokens-monster-core/assets/subjects/",
      "modules/pf2e-tokens-monster-core-2/assets/tokens/": "modules/pf2e-tokens-monster-core-2/assets/subjects/",
      "modules/pf2e-tokens-draconic-codex/assets/tokens/": "modules/pf2e-tokens-draconic-codex/assets/subjects/",
      "modules/pf2e-tokens-npc-core/assets/tokens/": "modules/pf2e-tokens-npc-core/assets/subjects/"
    },
    "pf2e-tokens-bestiaries": {
      "nimble-art": "modules/nimble-pathfinder-tokens/module/map-bestiaries.json"
    }
  },
  "relationships": {
    "requires": [
      {
        "id": "nimble",
        "type": "system",
        "compatibility": {}
      },
      {
        "id": "pf2e-tokens-bestiaries",
        "type": "module",
        "compatibility": {}
      }
    ],
    "recommends": [
      {
        "id": "pf2e-tokens-npc-core",
        "type": "module",
        "reason": "Art for bandits, guards, cultists and other humanoids"
      },
      {
        "id": "pf2e-tokens-monster-core",
        "type": "module",
        "reason": "More monster art, used ahead of Bestiaries for some creatures"
      },
      {
        "id": "pf2e-tokens-monster-core-2",
        "type": "module",
        "reason": "More monster art, used ahead of Bestiaries for some creatures"
      },
      {
        "id": "pf2e-tokens-draconic-codex",
        "type": "module",
        "reason": "Extra dragon art"
      }
    ]
  },
  "manifest": "https://github.com/javierriveracastro/nimble-pathfinder-tokens/releases/download/latest/module.json",
  "download": "https://github.com/javierriveracastro/nimble-pathfinder-tokens/releases/download/latest/nimble-pathfinder-tokens.zip",
  "description": "Maps Pathfinder token art onto Nimble monsters: the Nimble compendiums, and monsters imported from Nimble Nexus as they are created.",
  "esmodules": [
    "scripts/nimble-art.js"
  ]
}